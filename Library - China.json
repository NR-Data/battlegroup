          {"name": "Rng 0-10\"", "$text": "AP 4 / HE 2", "typeId": "805b-70a6-4f6f-c788"},
          {"name": "Rng 10-20\"", "$text": "AP 4 / HE 2", "typeId": "f0a9-c40f-687a-5df4"},
          {"name": "Rng 20-30\"", "$text": "AP 3 / HE 2", "typeId": "9f66-1c3f-e3d4-3272"},
          {"name": "Rng 30-40\"", "$text": "AP 2 / HE 2", "typeId": "2086-a3d3-0c4d-da50"},
          {"name": "Rng 40-50\"", "$text": "AP 1 / HE 2", "typeId": "5d14-a1b4-1118-2f5a"},
          {"name": "Rng 50-70\"", "$text": "-", "typeId": "344d-8655-b175-1aae"}
